        "title": "Coverage Q90"
      },
      "last_train_week": {
        "format": "date",
        "title": "Last Train Week",
        "type": "string"
      },
      "model_version": {
        "title": "Model Version",
        "type": "string"
      },
      "n_series": {
        "title": "N Series",
        "type": "integer"
      },
      "n_weeks": {
        "title": "N Weeks",
        "type": "integer"
      },
      "promotion": {
        "additionalProperties": true,
        "title": "Promotion",
        "type": "object"
      },
      "serving_tier": {
        "enum": [
          "lgbm",
          "baseline"
        ],
        "title": "Serving Tier",
        "type": "string"
      },
      "trained_at": {
        "format": "date-time",
        "title": "Trained At",
        "type": "string"
      }
