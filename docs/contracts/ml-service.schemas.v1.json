    "required": [
      "model_version",
      "serving_tier",
      "trained_at",
      "last_train_week",
      "n_series",
      "n_weeks",
      "promotion",
      "backtest_summary",
      "coverage_q90",
      "available_versions"
    ],
    "title": "ModelInfo",
    "type": "object"
  },
  "RecommendationRequest": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Data de referência (padrão: dia seguinte à última movimentação).",
        "title": "As Of"
      },
      "donor_demand_z": {
        "anyOf": [
          {
            "maximum": 3,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": ">0 deixa o doador mais conservador.",
        "title": "Donor Demand Z"
      },
      "lead_time_days": {
        "anyOf": [
          {
            "maximum": 30,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Lead Time Days"
      },
      "max_distance_km": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Só tem efeito quando há coordenadas.",
        "title": "Max Distance Km"
      },
      "min_shelf_life_days": {
        "anyOf": [
          {
            "maximum": 365,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Min Shelf Life Days"
      },
      "min_transfer_qty": {
        "anyOf": [
          {
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Min Transfer Qty"
      },
      "receiver_demand_z": {
        "anyOf": [
          {
            "maximum": 3,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Receiver Demand Z"
      }
    },
    "title": "RecommendationRequest",
    "type": "object"
  },
