# Copie para .env (NÃO versione). Gere segredos fortes: openssl rand -hex 32
POSTGRES_PASSWORD=troque
ML_READER_PASSWORD=troque
ML_API_KEY=troque-por-hex-de-32-bytes
JWT_PRIVATE_KEY=troque-por-segredo-de-no-minimo-40-caracteres

# Opcional: contexto de build do front-end.
# Padrão: repositório público na branch main.
# Para builds reproduzíveis, use uma tag ou commit no lugar de main.
# FRONTEND_CONTEXT=https://github.com/MuriWolf/fabrica-projetos-vi.git#main

# Opcional: porta publicada do front-end (padrão: 3000)
# FRONTEND_PORT=3000

# true = no primeiro up, popula o banco com dados fictícios (somente se estiver vazio).
# false = sobe com banco vazio (apenas migrações + usuários de bootstrap).
SEED_DEMO_DATA=true

# Cria os usuários abaixo no startup da API, somente se ainda não existirem.
# false = não cria/gerencia usuários pelo Compose.
BOOTSTRAP_USERS_ENABLED=true
ADMIN_EMAIL=admin@teste.com
ADMIN_PASSWORD=1234567890
MANAGER_EMAIL=manager@teste.com
MANAGER_PASSWORD=1234567890
OPERATOR_EMAIL=operator@teste.com
OPERATOR_PASSWORD=1234567890
